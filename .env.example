# ===== Бот =====
# Токен вашего бота, полученный от @BotFather
BOT_TOKEN=

# Список Telegram ID администраторов через запятую (без пробелов)
# Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Список Telegram ID руководителей через запятую (без пробелов).
# Задаётся только здесь — добавление через бот не предусмотрено.
# Пример: MANAGER_IDS=111222333,444555666
MANAGER_IDS=

# Путь к файлу базы данных SQLite
DB_PATH=hotline_service.db

# Таймаут (в секундах), после которого заявка считается просроченной
TICKET_TIMEOUT=300

# Таймаут (в секундах) незавершённой воронки оформления заявки (FSM).
# Если клиент долго не отвечает — состояние сбрасывается автоматически.
FSM_TIMEOUT=1800

# Кулдаун (в секундах) между созданием заявок одним клиентом — защита от спама.
TICKET_CREATE_COOLDOWN=60

# Каталог для сохранения фото/видео материалов (подпапки создаются по номеру заявки)
MEDIA_DIR=media

# ===== Логирование =====
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Путь к файлу лога (с ротацией)
LOG_FILE=bot.log

# ===== FSM-хранилище (опционально) =====
# Если задан REDIS_URL — используется RedisStorage для FSM, иначе — память
# Пример: redis://:password@redis:6379/0
REDIS_URL=

# Пароль Redis (ОБЯЗАТЕЛЕН для docker-compose). Дефолтного пароля нет —
# compose упадёт при старте, если переменная не задана или пуста.
# Внутри compose из него автоматически собирается REDIS_URL.
REDIS_PASSWORD=

# ===== Webhook-режим (опционально) =====
# Если задан WEBHOOK_URL — бот работает через webhook вместо поллинга
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Секретный токен для проверки входящих webhook-запросов от Telegram.
# Передаётся в заголовке X-Telegram-Bot-Api-Secret-Token. Сравнение — hmac.compare_digest.
# Если пусто — проверка отключена (не рекомендуется для продакшена).
WEBHOOK_SECRET_TOKEN=

# ===== Интеграция с Битрикс24 (создание задач) =====
# URL входящего вебхука Битрикс24. Пример: https://crm.example.ru/rest/14/ТОКЕН/
BITRIX_WEBHOOK_URL=

# Базовый URL портала Битрикс24 (без /rest/...) для формирования ссылок на задачи.
# Пример: https://crm.example.ru
BITRIX_PORTAL_URL=

# Приоритет создаваемых задач: 1 - низкий, 2 - средний, 3 - высокий, 4 - срочный
# Примечание: постановщик задач (CREATED_BY) жёстко фиксирован и равен 414
# (бизнес-требование) — см. bot/bitrix.py. Переменная не настраивается.
BITRIX_TASK_PRIORITY=2

# Дедлайн задачи в часах от момента взятия заявки (пусто — без дедлайна)
BITRIX_TASK_DEADLINE_HOURS=

# ID папки на диске Битрикс24 для загрузки файлов.
# Укажите валидный ID папки (например, «Сервис/Бот Медиа» — ID 1284728).
# Если папка не найдена, файлы не загружаются (в общий диск не падают).
BITRIX_DISK_FOLDER_ID=1284728

# Прикреплять ли файлы заявки к задаче (1 - да, 0 - нет)
BITRIX_ATTACH_FILES=1

# ID чата Битрикс24, куда отправляются уведомления о новых заявках (пусто — не отправлять)
BITRIX_CHAT_ID=

# ID пользователя Битрикс24, от имени которого отправляются сообщения в чат (пусто — автор вебхука)
BITRIX_FROM_USER_ID=

# Ключ для доступа к веб-дашборду руководителя.
# Передаётся в заголовке X-Dashboard-Key (query-параметр ?key= оставлен для
# навигации по ссылкам). Сравнение — hmac.compare_digest.
# ОБЯЗАТЕЛЕН, если дашборд слушает на не-localhost адресе (в Docker задаётся
# MANAGER_DASHBOARD_HOST=0.0.0.0) — иначе бот не стартует (fail fast).
MANAGER_DASHBOARD_KEY=

# Адрес, на котором слушает веб-дашборд. По умолчанию 127.0.0.1 (только локально).
# В docker-compose внутри контейнера задаётся 0.0.0.0, но наружу порт не публикуется.
MANAGER_DASHBOARD_HOST=127.0.0.1

# Порт веб-дашборда руководителя (по умолчанию 8081)
MANAGER_DASHBOARD_PORT=8081

# Публичный URL веб-дашборда (для ссылок в Telegram-уведомлениях)
MANAGER_DASHBOARD_URL=http://localhost:8081